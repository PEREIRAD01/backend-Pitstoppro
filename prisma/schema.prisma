generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  passwordHash String
  displayName  String
  vehicles     Vehicle[]
  maintenances Maintenance[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Vehicle {
  id           Int           @id @default(autoincrement())
  userId       Int
  plate        String
  brand        String
  model        String
  photoBytes   Bytes?
  photoMimeType String?
  year         Int?
  vehicleName  String?
  currentOdometerKm Int?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  maintenances Maintenance[]
  events       VehicleEvent[]
  trackedItems TrackedItem[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
  @@unique([userId, plate])
}

// === Enums for events, tracked items, and expenses ===
enum VehicleEventType {
  insurance
  inspection
  iuc
  custom
}

enum TrackedItemType {
  event
  part
}

enum ExpenseCategory {
  part
  event
  insurance
  inspection
  iuc
  custom
}

// === Vehicle events ===
model VehicleEvent {
  id        Int              @id @default(autoincrement())
  vehicleId Int
  eventType VehicleEventType
  dueDate   DateTime
  isDone    Boolean          @default(false)
  doneDate  DateTime?
  note      String?

  vehicle   Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  expenses  Expense[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([vehicleId, dueDate])
}

// === Tracked items and logs ===
model TrackedItem {
  id            Int             @id @default(autoincrement())
  vehicleId     Int
  itemType      TrackedItemType
  name          String
  notes         String?
  startDate     DateTime?
  startOdometer Int?
  validMonths   Int?
  validKm       Int?
  dueDate       DateTime?
  dueOdometer   Int?
  isDone        Boolean         @default(false)
  doneDate      DateTime?
  doneOdometer  Int?

  vehicle       Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  logs          TrackedItemLog[]
  expenses      Expense[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([vehicleId])
  @@index([itemType])
  @@index([vehicleId, dueDate])
}

model TrackedItemLog {
  id            Int         @id @default(autoincrement())
  trackedItemId Int
  logDate       DateTime
  odometerKm    Int?
  note          String?
  createdAt     DateTime    @default(now())

  trackedItem   TrackedItem @relation(fields: [trackedItemId], references: [id], onDelete: Cascade)

  @@index([trackedItemId, logDate])
}

// === Expenses (exactly one context) ===
model Expense {
  id             Int              @id @default(autoincrement())
  trackedItemId  Int?
  vehicleEventId Int?
  expenseDate    DateTime
  amountEur      Decimal          @db.Decimal(12, 2)
  category       ExpenseCategory
  description    String?
  vendor         String?

  trackedItem    TrackedItem?     @relation(fields: [trackedItemId], references: [id], onDelete: Cascade)
  vehicleEvent   VehicleEvent?    @relation(fields: [vehicleEventId], references: [id], onDelete: Cascade)

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([expenseDate])
  @@index([trackedItemId])
  @@index([vehicleEventId])
  @@index([category])
}

model Maintenance {
  id          Int      @id @default(autoincrement())
  userId      Int
  vehicleId   Int
  date        DateTime
  odometerKm  Int
  costEur     Decimal  @db.Decimal(10, 2)
  description String
  done        Boolean  @default(true)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([vehicleId])
}
